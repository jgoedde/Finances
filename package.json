{
    "name": "finances",
    "version": "2.0.2",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @finances/web",
        "dev:host": "npm run dev:host -w @finances/web",
        "build": "npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "knip:check": "knip",
        "dev:api": "npm run dev -w @finances/api",
        "test": "npm run test --workspaces --if-present"
    },
    "overrides": {
        "react-is": "^19.0.0-rc-69d4b800-20241021"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "knip": "^6.41.0",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.71.2"
    },
    "allowScripts": {
        "better-sqlite3": false
    }
}

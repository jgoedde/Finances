{
    "name": "finances",
    "private": true,
    "version": "2.7.1",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @finances/web",
        "dev:host": "npm run dev:host -w @finances/web",
        "build": "npm run build --workspaces --if-present",
        "lint": "concurrently --group --names web,api,shared \"npm run lint -w @finances/web\" \"npm run lint -w @finances/api\" \"npm run lint -w @finances/shared\"",
        "format": "prettier --write --cache .",
        "format:check": "prettier --check --cache .",
        "knip:check": "knip",
        "dev:api": "npm run dev -w @finances/api",
        "test": "npm run test --workspaces --if-present"
    },
    "overrides": {
        "react-is": "^19.0.0-rc-69d4b800-20241021"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "knip": "^6.42.1",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.72.0"
    },
    "allowScripts": {
        "better-sqlite3": false
    }
}

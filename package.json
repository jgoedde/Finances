{
    "name": "finances",
    "private": true,
    "version": "2.12.1",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "npm run dev -w @finances/web",
        "dev:api": "npm run dev -w @finances/api",
        "build": "npm run build --workspaces --if-present",
        "build:web": "npm run build -w @finances/web",
        "build:api": "npm run build -w @finances/api",
        "build:shared": "npm run build -w @finances/shared",
        "lint": "concurrently --group --names web,api,shared \"npm run lint:web\" \"npm run lint:api\" \"npm run lint:shared\"",
        "lint:web": "npm run lint -w @finances/web",
        "lint:api": "npm run lint -w @finances/api",
        "lint:shared": "npm run lint -w @finances/shared",
        "format": "prettier --write --cache .",
        "format:web": "prettier --write --cache apps/web",
        "format:api": "prettier --write --cache apps/api",
        "format:shared": "prettier --write --cache packages/shared",
        "format:check": "prettier --check --cache .",
        "format:check:web": "prettier --check --cache apps/web",
        "format:check:api": "prettier --check --cache apps/api",
        "format:check:shared": "prettier --check --cache packages/shared",
        "test": "npm run test --workspaces --if-present",
        "test:web": "npm run test -w @finances/web",
        "test:api": "npm run test -w @finances/api",
        "test:shared": "npm run test -w @finances/shared",
        "check:web": "npm run format:check:web && npm run lint:web && npm run build:web && npm run test:web",
        "check:api": "npm run format:check:api && npm run lint:api && npm run build:api && npm run test:api",
        "check:shared": "npm run format:check:shared && npm run lint:shared && npm run build:shared && npm run test:shared",
        "knip:check": "knip",
        "mock-data": "node docs/screenshots/generate-mock-data.mjs"
    },
    "overrides": {
        "react-is": "^19.0.0-rc-69d4b800-20241021"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "concurrently": "^10.0.7",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "knip": "^6.48.0",
        "prettier": "^3.10.1",
        "typescript-eslint": "^8.74.0"
    },
    "allowScripts": {
        "better-sqlite3": false
    }
}

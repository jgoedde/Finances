# Copy to .env for `npm run dev:api`.
DATABASE_PATH=./finances.db
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BASE_URL=http://localhost:5173
PORT=3000
# Creates the first admin when no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional, comma-separated: extra origins allowed to sign in, e.g. when
# testing on a phone via `npm run dev:host`: http://192.168.1.10:5173
TRUSTED_ORIGINS=

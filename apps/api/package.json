        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.1",
